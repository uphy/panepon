  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
